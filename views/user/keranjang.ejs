<%- include('../partials/header') %>

    <div style="max-width: 1140px; margin: 0 auto; padding-bottom: 90px;">
        <!-- Tombol Kembali ke Menu -->
        <div style="margin-bottom: 20px;">
            <a href="/menu" class="btn btn-secondary btn-sm"
                style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="m15 18-6-6 6-6"></path>
                </svg>
                <span>Kembali</span>
            </a>
        </div>

        <!-- Form Utama Pemesanan & Pembayaran -->
        <form action="/user_checkout" method="POST" id="checkoutForm">
            <input type="hidden" name="cart_data" id="cartDataInput">

            <!-- Layout 2 Kolom Luas & Sangat Terstruktur -->
            <div class="cart-page-layout">
                <!-- Kolom Kiri: 3 Bagian Utama yang Terbuka & Jelas (Daftar Menu, Identitas Meja, Metode Bayar) -->
                <div>
                    <!-- BAGIAN 1: DAFTAR MENU PESANAN -->
                    <div class="card cart-card" style="margin-bottom: 20px;">
                        <div
                            style="margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);">
                            <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0;">
                                Daftar Menu Pesanan
                            </h2>
                        </div>

                        <!-- Container Daftar Menu di Keranjang -->
                        <div id="cartItemsContainer">
                            <!-- Auto-Rendered by POS_CART in app.js -->
                        </div>
                    </div>

                    <!-- BAGIAN 2: INFORMASI MEJA & IDENTITAS PEMESAN -->
                    <div class="card cart-card" style="margin-bottom: 20px;">
                        <div
                            style="margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);">
                            <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0;">
                                Informasi Meja & Identitas Pemesan
                            </h2>
                        </div>

                        <div class="cart-form-grid" style="margin-bottom: 14px;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" style="font-weight: 700; font-size: 0.84rem;">Nomor Meja
                                    *</label>
                                <select name="nomor_meja" class="form-control" required
                                    style="height: 44px; font-size: 0.9rem;">
                                    <% for (let i = 1; i <= 20; i++) { %>
                                        <option value="Meja <%= i < 10 ? '0' + i : i %>">Meja <%= i < 10 ? '0' + i : i %></option>
                                    <% } %>
                                    <option value="Take Away (Bungkus)">Take Away (Bungkus)</option>
                                </select>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" style="font-weight: 700; font-size: 0.84rem;">Nama Pemesan
                                    *</label>
                                <input type="text" name="nama_pelanggan" id="inputNamaPelanggan" class="form-control"
                                    placeholder="Nama pemesan" required style="height: 44px; font-size: 0.9rem;">
                            </div>
                        </div>

                        <div class="cart-form-grid">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" style="font-weight: 700; font-size: 0.84rem;">No. WhatsApp /
                                    Telepon (Opsional)</label>
                                <input type="tel" name="no_telepon" class="form-control"
                                    placeholder="Nomor telepon aktif" style="height: 44px; font-size: 0.9rem;">
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" style="font-weight: 700; font-size: 0.84rem;">Catatan Khusus
                                    (Opsional)</label>
                                <input type="text" name="catatan" class="form-control" placeholder="Catatan pesanan"
                                    style="height: 44px; font-size: 0.9rem;">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Kolom Kanan: Ringkasan Tagihan & Tombol Konfirmasi -->
                <div>
                    <div class="card cart-card cart-summary-card" style="margin-bottom: 30px;">
                        <div
                            style="margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-light);">
                            <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--text-main); margin: 0;">
                                Ringkasan Pembayaran
                            </h3>
                        </div>

                        <!-- Receipt Breakdown -->
                        <div class="cart-bill-summary" style="margin-bottom: 20px;">
                            <div class="bill-row bill-total-row" style="border-top: none; padding-top: 0;">
                                <span style="font-size: 1.05rem;">Total Pembayaran</span>
                                <span id="cartTotalDisplay" class="bill-total-price">Rp 0</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block btn-lg" id="btnSubmitOrder" disabled
                            style="height: 50px; font-weight: 800; font-size: 0.98rem; box-shadow: 0 4px 14px rgba(194, 65, 12, 0.35);">
                            Kirim Pesanan Sekarang
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script>
        // Client-side Validation: Nama Pemesan Wajib Diisi
        document.addEventListener('DOMContentLoaded', function () {
            const checkoutForm = document.getElementById('checkoutForm');
            if (checkoutForm) {
                checkoutForm.addEventListener('submit', function (e) {
                    const nameInput = document.getElementById('inputNamaPelanggan');
                    if (!nameInput || !nameInput.value.trim()) {
                        e.preventDefault();
                        if (nameInput) {
                            nameInput.focus();
                            nameInput.style.borderColor = 'var(--accent-red)';
                            nameInput.style.boxShadow = '0 0 0 2px rgba(239, 68, 68, 0.2)';
                        }
                        showToast('error', 'Nama Pemesan wajib diisi terlebih dahulu!');
                        return false;
                    }

                    if (typeof POS_CART !== 'undefined' && POS_CART.items.length === 0) {
                        e.preventDefault();
                        POS_CART.showToast('Keranjang belanja Anda masih kosong!', 'error');
                        return false;
                    }

                    // Bersihkan localStorage setelah pesanan dikirim
                    setTimeout(() => {
                        try {
                            localStorage.removeItem('dapur_ina_cart');
                        } catch(err) {}
                    }, 100);
                });
            }
        });
    </script>

    <%- include('../partials/footer') %>