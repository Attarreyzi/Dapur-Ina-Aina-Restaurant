<%- include('../partials/header') %>

    <!-- Stats Overview Cards (Clean, Color-Coded) -->
    <div class="stats-grid">
        <div class="stat-card stat-card-green">
            <div class="stat-label">Omset Hari Ini</div>
            <div class="stat-value" style="color: #15803d;">
                <%= formatRupiah(stats.omset_hari_ini) %>
            </div>
        </div>

        <div class="stat-card stat-card-terracotta">
            <div class="stat-label">Total Omset Keseluruhan</div>
            <div class="stat-value" style="color: var(--primary);">
                <%= formatRupiah(stats.total_pendapatan) %>
            </div>
        </div>

        <div class="stat-card stat-card-indigo">
            <div class="stat-label">Menu Terdaftar</div>
            <div class="stat-value" style="color: #4338ca;">
                <%= stats.total_menu %> Menu
            </div>
        </div>

        <div class="stat-card stat-card-red">
            <div class="stat-label">Stok Menipis / Habis</div>
            <div class="stat-value" style="color: #b91c1c;">
                <%= stats.menu_menipis %> Menu
            </div>
        </div>
    </div>

    <!-- Grafik Tren Penjualan & Pendapatan (Desktop & Mobile Responsive) -->
    <div class="card" style="margin-top: 14px; margin-bottom: 20px; padding: 20px 22px;">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div>
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin-bottom: 3px; display: flex; align-items: center; gap: 8px;">
                    Tren Penjualan & Omset
                </h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">
                </p>
            </div>

            <!-- Filter Switcher: 7 Hari Terakhir vs Bulanan -->
            <div style="display: inline-flex; background: var(--bg-input); padding: 4px; border-radius: var(--radius-md); border: 1px solid var(--border-light); gap: 4px; max-width: 100%;">
                <button type="button" id="btnFilter7Hari" class="btn-chart-filter active" onclick="switchChartMode('7days')">
                    7 Hari Terakhir
                </button>
                <button type="button" id="btnFilterBulanan" class="btn-chart-filter" onclick="switchChartMode('monthly')">
                    Bulanan (<%= new Date().getFullYear() %>)
                </button>
            </div>
        </div>

        <!-- Metric Highlight Bar (Warna Teks Tegas & Kontras Tinggi) -->
        <div style="display: flex; flex-wrap: wrap; gap: 16px; padding: 10px 14px; background: #fafaf9; border-radius: var(--radius-md); margin-bottom: 16px; border: 1px solid var(--border-light); align-items: center;">
            <div style="display: flex; align-items: baseline; gap: 6px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #0f172a;">Total Omset Periode:</span>
                <strong id="chartTotalOmset" style="font-size: 0.98rem; font-weight: 800; color: #0f172a;">Rp 0</strong>
            </div>
            <div style="width: 1px; height: 16px; background: var(--border-light);"></div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #0f172a;">Total Transaksi:</span>
                <strong id="chartTotalTx" style="font-size: 0.98rem; font-weight: 800; color: #0f172a;">0 Transaksi</strong>
            </div>
        </div>

        <!-- Canvas Container with Responsive Height -->
        <div class="chart-container-responsive">
            <canvas id="salesTrendChart"></canvas>
        </div>
    </div>

    <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 8px;">
        <!-- Top 3 Menu Terlaris -->
        <div class="card" style="display: flex; flex-direction: column;">
            <div class="card-header">
                <h3 style="font-size: 1.05rem; color: var(--text-main);">Top 3 Menu Paling Laris</h3>
            </div>

            <div style="flex: 1;">
                <% if (stats.top_menu && stats.top_menu.length> 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <% stats.top_menu.forEach((item, index)=> { %>
                            <div
                                style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-xs); gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1;">
                                    <span class="rank-badge" style="flex-shrink: 0;">
                                        <%= index + 1 %>
                                    </span>
                                    <div style="min-width: 0; flex: 1;">
                                        <div
                                            style="font-weight: 800; font-size: 0.92rem; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <%= item.nama_produk %>
                                        </div>
                                        <div
                                            style="font-size: 0.74rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <%= item.kategori %>
                                        </div>
                                    </div>
                                </div>
                                <div style="text-align: right; flex-shrink: 0; white-space: nowrap;">
                                    <span
                                        style="font-size: 0.78rem; font-weight: 800; background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; padding: 3px 10px; border-radius: var(--radius-full); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 2px; white-space: nowrap;">
                                        <%= item.total_terjual %> Porsi
                                    </span>
                                    <div
                                        style="font-size: 0.8rem; color: var(--text-main); font-weight: 700; white-space: nowrap;">
                                        <%= formatRupiah(item.total_omset) %>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 24px; color: var(--text-muted); font-size: 0.88rem;">
                            Belum ada data penjualan tercatat.
                        </div>
                        <% } %>
            </div>

            <!-- Link di Bagian Bawah Kotak -->
            <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-light); text-align: center;">
                <a href="/stok" class="card-footer-link">Kelola Stok →</a>
            </div>
        </div>

        <!-- Peringatan Stok Menipis -->
        <div class="card" style="display: flex; flex-direction: column;">
            <div class="card-header">
                <h3 style="font-size: 1.05rem; color: #181818ed;">Stok Menipis</h3>
            </div>

            <div style="flex: 1;">
                <% if (lowStockItems && lowStockItems.length> 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <% lowStockItems.forEach(prod=> { %>
                            <div
                                style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: #fef2f2; border: 1px solid #fee2e2; border-left: 3px solid #ef4444; border-radius: var(--radius-md); gap: 12px;">
                                <div style="min-width: 0; flex: 1;">
                                    <div
                                        style="font-weight: 700; font-size: 0.9rem; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <%= prod.nama_produk %>
                                    </div>
                                    <div
                                        style="font-size: 0.74rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <%= prod.kategori %>
                                    </div>
                                </div>
                                <span class="stock-badge stock-habis"
                                    style="font-size: 0.75rem; flex-shrink: 0; white-space: nowrap;">
                                    <%= prod.stok===0 ? 'HABIS' : 'Sisa ' + prod.stok + ' porsi' %>
                                </span>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 24px; color: var(--text-muted); font-size: 0.88rem;">
                            Semua stok menu aman dan mencukupi.
                        </div>
                        <% } %>
            </div>

            <!-- Link di Bagian Bawah Kotak -->
            <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border-light); text-align: center;">
                <a href="/stok" class="card-footer-link">Update Stok →</a>
            </div>
        </div>
    </div>

    <!-- Pesanan Masuk & Antrean Meja (Live Menunggu Konfirmasi / Bayar di Kasir) -->
    <div class="card card-table" style="margin-top: 20px; padding: 0; overflow: hidden; border: 1.5px solid #fde68a;">
        <div class="card-header"
            style="padding: 14px 18px; border-bottom: 1px solid #fef3c7; background: #fffbeb; margin-bottom: 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #eab308; animation: pulse 1.8s infinite;"></span>
                <h3 style="font-size: 1.05rem; color: #854d0e; margin: 0; font-weight: 800;">
                    Pesanan Masuk (Menunggu Pembayaran / Kasir)
                </h3>
            </div>
            <span class="stock-badge stock-warning" style="font-size: 0.8rem; font-weight: 800; padding: 4px 12px;">
                <%= (stats.pending_orders && stats.pending_orders.length) || stats.total_menunggu || 0 %> Pesanan Aktif
            </span>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>No. Pesanan</th>
                        <th>Waktu Pesan</th>
                        <th>Pelanggan & Meja</th>
                        <th>Rincian Menu</th>
                        <th>Status</th>
                        <th>Total Tagihan</th>
                        <th>Aksi Kasir</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (stats.pending_orders && stats.pending_orders.length > 0) { %>
                        <% stats.pending_orders.forEach(p => { %>
                            <tr style="background: #fffdf5;">
                                <td><strong style="color: var(--text-main);"><%= p.no_pesanan %></strong></td>
                                <td><%= formatDate(p.waktu_pesan) %></td>
                                <td>
                                    <div><strong style="color: #0f172a;"><%= p.nama_pelanggan || 'Pelanggan Meja' %></strong></div>
                                    <div style="font-size: 0.78rem; font-weight: 700; color: #b45309;"><%= p.nomor_meja %></div>
                                </td>
                                <td style="max-width: 260px; font-size: 0.84rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= p.rincian_menu %>">
                                    <%= p.rincian_menu || '-' %>
                                </td>
                                <td>
                                    <span class="stock-badge stock-warning" style="font-size: 0.76rem; font-weight: 800;">
                                        Menunggu Konfirmasi
                                    </span>
                                </td>
                                <td><strong style="color: var(--primary);"><%= formatRupiah(p.total_tagihan) %></strong></td>
                                <td>
                                    <a href="/billing/<%= p.id_pesanan %>" class="btn btn-warning btn-sm" style="font-weight: 800; padding: 5px 12px; font-size: 0.82rem; white-space: nowrap;">
                                        Proses Bayar →
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-dim); padding: 28px;">
                                Tidak ada antrean pesanan yang menunggu pembayaran.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Riwayat Transaksi Terakhir Selesai -->
    <div class="card card-table" style="margin-top: 20px; padding: 0; overflow: hidden;">
        <div class="card-header"
            style="padding: 14px 18px; border-bottom: 1px solid var(--border-light); margin-bottom: 0;">
            <h3 style="font-size: 1.05rem; color: var(--text-main);">Transaksi Terakhir Selesai</h3>
        </div>

        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>No. Pesanan</th>
                        <th>Waktu Bayar</th>
                        <th>Pelanggan / Meja</th>
                        <th>Metode</th>
                        <th>Total Tagihan</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (stats.recent_transaksi && stats.recent_transaksi.length> 0) { %>
                        <% stats.recent_transaksi.forEach(tx=> { %>
                            <tr>
                                <td><strong style="color: var(--text-main);">
                                        <%= tx.no_pesanan %>
                                    </strong></td>
                                <td>
                                    <%= formatDate(tx.tanggal_bayar) %>
                                </td>
                                <td>
                                    <%= tx.nama_pelanggan || 'Umum' %> (<%= tx.nomor_meja %>)
                                </td>
                                <td>
                                    <% if (tx.metode==='tunai' ) { %>
                                        <span class="badge-tunai">Tunai</span>
                                        <% } else { %>
                                            <span class="badge-nontunai">Non Tunai</span>
                                            <% } %>
                                </td>
                                <td><strong style="color: var(--text-main);">
                                        <%= formatRupiah(tx.jumlah_bayar) %>
                                    </strong></td>
                                <td>
                                    <a href="/cetak/<%= tx.id_pesanan %>" class="btn btn-secondary btn-sm"
                                        target="_blank">
                                        Struk
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6"
                                            style="text-align: center; color: var(--text-dim); padding: 24px;">
                                            Belum ada transaksi yang tercatat.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Link di Bagian Bawah Kotak -->
        <div style="padding: 12px 18px; border-top: 1px solid var(--border-light); background: #fafafa; text-align: center;">
            <a href="/riwayat" class="card-footer-link">Lihat Semua Riwayat Pesanan →</a>
        </div>
    </div>

    <!-- Chart.js Library via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function() {
            const chart7Days = <%- JSON.stringify(stats.chart_7_days || { labels: [], omset: [], transaksi: [] }) %>;
            const chartMonthly = <%- JSON.stringify(stats.chart_monthly || { labels: [], omset: [], transaksi: [] }) %>;

            let currentMode = '7days';
            let salesChart = null;

            function formatRp(val) {
                return 'Rp ' + Number(val || 0).toLocaleString('id-ID');
            }

            function updateMetrics(mode) {
                const data = mode === '7days' ? chart7Days : chartMonthly;
                const totalOmset = (data.omset || []).reduce((a, b) => a + b, 0);
                const totalTx = (data.transaksi || []).reduce((a, b) => a + b, 0);

                const omsetEl = document.getElementById('chartTotalOmset');
                const txEl = document.getElementById('chartTotalTx');
                if (omsetEl) omsetEl.textContent = formatRp(totalOmset);
                if (txEl) txEl.textContent = totalTx + ' Transaksi';
            }

            function initChart() {
                const canvas = document.getElementById('salesTrendChart');
                if (!canvas) return;

                const initialData = chart7Days;
                updateMetrics('7days');

                const ctx = canvas.getContext('2d');
                const gradient = ctx.createLinearGradient(0, 0, 0, 260);
                gradient.addColorStop(0, 'rgba(194, 65, 12, 0.28)');
                gradient.addColorStop(1, 'rgba(194, 65, 12, 0.01)');

                salesChart = new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: initialData.labels,
                        datasets: [
                            {
                                label: 'Omset Penjualan',
                                data: initialData.omset,
                                borderColor: '#c2410c',
                                backgroundColor: gradient,
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: '#ffffff',
                                pointBorderColor: '#c2410c',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointHoverBackgroundColor: '#c2410c',
                                pointHoverBorderColor: '#ffffff',
                                pointHoverBorderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                titleFont: { size: 12, weight: 'bold' },
                                bodyFont: { size: 12 },
                                padding: 10,
                                cornerRadius: 8,
                                displayColors: false,
                                callbacks: {
                                    label: function(context) {
                                        return 'Omset: ' + formatRp(context.raw);
                                    },
                                    afterLabel: function(context) {
                                        const idx = context.dataIndex;
                                        const curData = currentMode === '7days' ? chart7Days : chartMonthly;
                                        const tx = (curData.transaksi && curData.transaksi[idx]) || 0;
                                        return 'Transaksi: ' + tx + ' pesanan';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    font: { size: 11 },
                                    color: '#64748b',
                                    maxRotation: 45,
                                    minRotation: 0
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: '#f1f5f9',
                                    borderDash: [3, 3]
                                },
                                ticks: {
                                    font: { size: 11 },
                                    color: '#64748b',
                                    callback: function(value) {
                                        if (value >= 1000000) return 'Rp ' + (value / 1000000).toFixed(1) + 'M';
                                        if (value >= 1000) return 'Rp ' + (value / 1000).toFixed(0) + 'k';
                                        return 'Rp ' + value;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            window.switchChartMode = function(mode) {
                if (!salesChart || currentMode === mode) return;
                currentMode = mode;

                const btn7 = document.getElementById('btnFilter7Hari');
                const btnM = document.getElementById('btnFilterBulanan');
                if (mode === '7days') {
                    if (btn7) btn7.classList.add('active');
                    if (btnM) btnM.classList.remove('active');
                } else {
                    if (btnM) btnM.classList.add('active');
                    if (btn7) btn7.classList.remove('active');
                }

                const targetData = mode === '7days' ? chart7Days : chartMonthly;
                salesChart.data.labels = targetData.labels;
                salesChart.data.datasets[0].data = targetData.omset;
                salesChart.update();

                updateMetrics(mode);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initChart);
            } else {
                initChart();
            }
        })();
    </script>

    <%- include('../partials/footer') %>