<%# ========== TOAST NOTIFICATION SYSTEM ========== %>
<%# Toast Container ditempatkan langsung di body-level dengan position: fixed %>
<div id="toastContainer" aria-live="polite" aria-atomic="false"></div>

<%# Flash dari server (flash_success / flash_error) %>
<% if (locals.flash_success || locals.flash_error) { %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        showToast(
            '<%= locals.flash_success ? "success" : "error" %>',
            '<%= (locals.flash_success || locals.flash_error || "").replace(/'/g, "\\'") %>'
        );
    });
</script>
<% } %>

<%# ========== GLOBAL TOAST ENGINE (SINGLE ACTIVE TOAST) ========== %>
<script>
(function() {
    if (window.__toastInitialized) return;
    window.__toastInitialized = true;

    var currentToastTimer = null;

    /**
     * showToast(type, message, duration)
     * type: 'success' | 'error' | 'info' | 'warning'
     * MENJAMIN HANYA 1 TOAST AKTIF (TIDAK MENUMPUK MEMENUHI LAYAR)
     */
    window.showToast = function(type, message, duration) {
        type = type || 'info';
        if (!duration) {
            duration = (type === 'error' || type === 'warning') ? 3200 : 2000;
        }

        var container = document.getElementById('toastContainer');
        if (!container) return;

        // 1. HAPUS TOAST SEBELUMNYA (Mencegah layar penuh saat klik berkali-kali)
        if (currentToastTimer) {
            clearTimeout(currentToastTimer);
            currentToastTimer = null;
        }
        var oldToasts = container.querySelectorAll('.toast-pill');
        oldToasts.forEach(function(old) {
            if (old.parentNode) old.parentNode.removeChild(old);
        });

        // 2. TEMA WARNA & IKON (Desain Modern Compact Pill)
        var themes = {
            success: {
                bg: '#ffffff',
                border: '#bbf7d0',
                iconBg: '#16a34a',
                textColor: '#15803d',
                bodyColor: '#1e293b',
                icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
            },
            error: {
                bg: '#ffffff',
                border: '#fecaca',
                iconBg: '#dc2626',
                textColor: '#b91c1c',
                bodyColor: '#1e293b',
                icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
            },
            warning: {
                bg: '#ffffff',
                border: '#fde68a',
                iconBg: '#d97706',
                textColor: '#b45309',
                bodyColor: '#1e293b',
                icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
            },
            info: {
                bg: '#ffffff',
                border: '#bfdbfe',
                iconBg: '#2563eb',
                textColor: '#1d4ed8',
                bodyColor: '#1e293b',
                icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>'
            }
        };

        var theme = themes[type] || themes.info;

        var toast = document.createElement('div');
        toast.className = 'toast-pill';
        toast.setAttribute('role', 'alert');
        toast.style.cssText =
            'display: inline-flex; align-items: center; gap: 10px;' +
            'background: ' + theme.bg + '; border: 1.5px solid ' + theme.border + ';' +
            'border-radius: 9999px; padding: 7px 14px 7px 8px;' +
            'box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.15), 0 4px 10px -2px rgba(0, 0, 0, 0.08);' +
            'max-width: calc(100vw - 32px); width: max-content;' +
            'transform: translateY(-20px) scale(0.95); opacity: 0;' +
            'transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;' +
            'cursor: pointer; pointer-events: all; user-select: none; z-index: 99999;';

        toast.innerHTML =
            '<div style="width: 24px; height: 24px; border-radius: 50%; background: ' + theme.iconBg + '; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">' +
                theme.icon +
            '</div>' +
            '<div style="font-size: 0.86rem; font-weight: 600; color: ' + theme.bodyColor + '; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;">' +
                message +
            '</div>';

        container.appendChild(toast);

        // Animasi Masuk
        requestAnimationFrame(function() {
            requestAnimationFrame(function() {
                toast.style.transform = 'translateY(0) scale(1)';
                toast.style.opacity = '1';
            });
        });

        // Klik langsung menutup toast
        toast.addEventListener('click', function() {
            closeToast(toast);
        });

        // Auto remove
        currentToastTimer = setTimeout(function() {
            closeToast(toast);
        }, duration);

        function closeToast(el) {
            if (!el || !el.parentNode) return;
            el.style.transform = 'translateY(-16px) scale(0.92)';
            el.style.opacity = '0';
            setTimeout(function() {
                if (el.parentNode) el.parentNode.removeChild(el);
            }, 220);
        }
    };
})();
</script>
