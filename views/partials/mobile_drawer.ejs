<!-- Mobile Slide-Out Drawer Navigation -->
<div class="mobile-drawer-backdrop" id="mobileDrawerBackdrop" onclick="closeMobileDrawer()"></div>

<aside class="mobile-drawer" id="mobileDrawer" aria-label="Menu Navigasi Mobile">
    <div class="mobile-drawer-header">
        <div style="display: flex; align-items: center; gap: 10px;">
            <div class="brand-emblem" style="width: 38px; height: 38px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                    <line x1="6" y1="1" x2="6" y2="4"></line>
                    <line x1="10" y1="1" x2="10" y2="4"></line>
                    <line x1="14" y1="1" x2="14" y2="4"></line>
                </svg>
            </div>
            <div>
                <div class="brand-title" style="font-size: 1.05rem;">Dapur Ina Aina</div>
                <div class="brand-subtitle" style="font-size: 0.72rem; color: var(--primary); font-weight: 700;">
                </div>
            </div>
        </div>
        <button type="button" class="mobile-drawer-close" onclick="closeMobileDrawer()" aria-label="Tutup Menu">
            ✕
        </button>
    </div>

    <% if (locals.admin) { %>
        <nav class="mobile-drawer-nav">
            <div class="nav-section-title">Menu Utama Admin</div>
            <a href="/dashboard" class="mobile-drawer-link <%= currentPath === '/dashboard' ? 'active' : '' %>"
                onclick="closeMobileDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>Dashboard</span>
            </a>
            <a href="/transaksi" class="mobile-drawer-link <%= currentPath === '/transaksi' ? 'active' : '' %>"
                onclick="closeMobileDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                <span>Kasir POS</span>
            </a>
            <a href="/stok" class="mobile-drawer-link <%= currentPath.startsWith('/stok') ? 'active' : '' %>"
                onclick="closeMobileDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path
                        d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                    </path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                <span>Kelola Stok & Menu</span>
            </a>
            <a href="/riwayat" class="mobile-drawer-link <%= currentPath.startsWith('/riwayat') ? 'active' : '' %>"
                onclick="closeMobileDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Riwayat Pesanan</span>
            </a>
            <a href="/laporan"
                class="mobile-drawer-link <%= currentPath.startsWith('/laporan') || currentPath.startsWith('/cetak_laporan') ? 'active' : '' %>"
                onclick="closeMobileDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span>Laporan Penjualan</span>
            </a>
        </nav>

        <!-- Tombol Logout Terpisah di Paling Bawah Menggunakan Kotak Persegi Panjang -->
        <div class="mobile-drawer-footer" style="padding: 14px 16px; border-top: 1px solid var(--border-light); margin-top: auto; background: #fafafa;">
            <a href="/logout" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 16px; background: #fff1f2; border: 1.5px solid #fecdd3; border-radius: var(--radius-md); color: #e11d48; font-weight: 700; font-size: 0.9rem; text-decoration: none; width: 100%; box-sizing: border-box; transition: all 0.2s; box-shadow: var(--shadow-xs);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Logout</span>
            </a>
        </div>
        <% } else { %>
            <!-- Guest / Customer Navigation -->
            <nav class="mobile-drawer-nav">
                <div class="nav-section-title">Menu Pelanggan</div>
                <a href="/menu"
                    class="mobile-drawer-link <%= currentPath === '/menu' || currentPath === '/' ? 'active' : '' %>"
                    onclick="closeMobileDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                    <span>Buku Menu</span>
                </a>
                <a href="/keranjang" class="mobile-drawer-link <%= currentPath === '/keranjang' ? 'active' : '' %>"
                    onclick="closeMobileDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <span style="flex: 1;">Keranjang</span>
                    <span class="cart-badge-count"
                        style="background: var(--primary); color: #ffffff; font-size: 0.72rem; padding: 2px 8px; border-radius: var(--radius-full); font-weight: 800;">0</span>
                </a>
                <a href="/pesanan" class="mobile-drawer-link <%= currentPath.startsWith('/pesanan') ? 'active' : '' %>"
                    onclick="closeMobileDrawer()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Status Pesanan</span>
                </a>
            </nav>

            <% } %>
</aside>