<%- include('../partials/header') %>

    <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px;">
        <div class="card" style="width: 100%; max-width: 400px; padding: 28px; box-shadow: var(--shadow-md);">
            <div style="text-align: center; margin-bottom: 24px;">
                <h2 style="font-size: 1.4rem; margin-bottom: 4px; color: var(--text-main);">LOGIN</h2>
                <p style="color: var(--text-muted); font-size: 0.85rem;">Silahkan Masuk
                </p>
            </div>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="admin@dapurina.com"
                        value="admin@dapurina.com" required autofocus>
                </div>

                <div class="form-group">
                    <label class="form-label">Kata Sandi</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" value="DapurIna#2026!"
                        required>
                </div>

                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 10px;">
                    Masuk ke Panel Admin
                </button>
            </form>

            <div
                style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-light); text-align: center; font-size: 0.85rem;">
                <a href="/menu" style="color: var(--primary); font-weight: 700; text-decoration: none;">
                    ← Kembali ke Menu Pelanggan
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>