# Konfigurasi Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=dapur_ina_super_secret_key_2026

# Konfigurasi Database PostgreSQL
# Opsi 1: Menggunakan URL Koneksi Lengkap (Cocok untuk Cloud/Deploy di Render, Railway, Supabase, Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dapur_ina_db

# Opsi 2: Konfigurasi Parameter Terpisah (Optional jika DATABASE_URL tidak digunakan)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dapur_ina_db

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here
MIDTRANS_IS_PRODUCTION=false

